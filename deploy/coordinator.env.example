# Pinet coordinator configuration. Keep this file 0600, owned by pinet.
# Copy to /etc/pinet/coordinator.env and fill in.

# Bind locally; TLS + public exposure are handled by nginx.
PINET_HOST=127.0.0.1
PINET_PORT=8787

# Public origin, used for device-flow verification URLs and OAuth redirects.
PINET_PUBLIC_URL=https://hub.example.com

# Stable logical server id (keep constant across restarts).
PINET_SERVER_ID=srv_change_me

# HMAC secret for session tokens. Generate with: openssl rand -hex 32
PINET_SESSION_SECRET=change_me

# Durable state (accounts, devices, MFA). Owned by pinet, mode 0700.
PINET_DATA_DIR=/var/lib/pinet

# Bring your own Google OAuth client (type: Web application).
# Authorized redirect URI: https://hub.example.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hub.example.com/auth/callback
