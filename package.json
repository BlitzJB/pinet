{
  "name": "pinet",
  "version": "0.6.3",
  "description": "Remote control for pi coding-agent sessions: a coordinator, a pi host extension, a pi-as-portal extension, and generic clients.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "remote",
    "websocket"
  ],
  "pi": {
    "extensions": [
      "./extension/index.ts",
      "./extension/portal.ts"
    ]
  },
  "scripts": {
    "hub": "node src/coordinator/server.mjs",
    "controller": "node src/controller/cli.mjs",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "conformance:generate": "node scripts/generate-conformance.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.87.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlitzJB/pinet.git"
  },
  "homepage": "https://github.com/BlitzJB/pinet#readme",
  "bugs": {
    "url": "https://github.com/BlitzJB/pinet/issues"
  }
}
